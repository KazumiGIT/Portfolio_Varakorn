# Desk terminal AI (the chat on the home page monitor).
# Get a key at https://aistudio.google.com/apikey then copy this file to .env
# On Vercel: add GEMINI_API_KEY in Project Settings -> Environment Variables.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Guestbook (comments on experience pages and blog posts).
# Neon Postgres connection string from the Vercel Storage tab.
# On Vercel the Neon integration injects it automatically; this local copy is
# for dev and for the moderation CLI (scripts/comments-db.mjs).
DATABASE_URL=
