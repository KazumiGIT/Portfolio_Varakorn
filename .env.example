# Desk terminal AI (the chat on the home page monitor).
# Get a key at https://aistudio.google.com/apikey then copy this file to .env
# On Vercel: add GEMINI_API_KEY in Project Settings -> Environment Variables.
GEMINI_API_KEY=

# Optional. Must look like a model name (gemini-2.5-flash, gemini-3-flash-preview).
# Anything else is ignored and the default is used, so a stray paste cannot
# take the chat down.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Supabase: accounts, the guestbook, bookmarks, and the rest of the account
# features. All four come from the Supabase dashboard.
# ---------------------------------------------------------------------------

# Settings -> API -> Project URL. The https one, NOT a connection string.
# Public by design; it is baked into the front end.
SUPABASE_URL=

# Settings -> API -> anon / publishable key. Also public by design.
SUPABASE_ANON_KEY=

# Settings -> API -> service_role. SECRET. Server side only, never in the
# browser: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> Database -> Connection string -> Transaction pooler (port 6543).
# SECRET. This is what the app and the moderation CLI use.
DATABASE_URL=

# Settings -> Database -> Connection string -> Direct connection (port 5432).
# SECRET. Used for schema migrations and DDL, which the transaction pooler
# does not handle well.
SUPABASE_DB_DIRECT_URL=

# ---------------------------------------------------------------------------
# Legacy. Both are from the pre Supabase guestbook and go away once accounts
# move to Supabase Auth. Google sign in is configured in the Supabase
# dashboard now (Authentication -> Providers -> Google), not here.
# ---------------------------------------------------------------------------

# OAuth web client id from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Session cookie signing secret. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
